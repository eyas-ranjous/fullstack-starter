{
  "name": "fullstack-starter",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "predev": "find packages/*/src -name '*.js' -delete 2>/dev/null; true",
    "dev": "pnpm -r dev",
    "dev:api": "pnpm --filter @apps/api dev",
    "dev:web": "pnpm --filter @apps/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
